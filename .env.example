# Docker Compose environment template
# Copy to .env only when running Docker Compose locally. Never commit .env.

DB_PASSWORD=<choose-a-strong-local-password>
ADMIN_API_KEY=<optional-random-admin-key>
# Optional only with `docker compose --profile exit-guidance-observe up -d`.
# The service is lease-only: it does not schedule or generate exit guidance.
EXIT_GUIDANCE_EOD_OWNER_ID=
