# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://stock_analyst_user:secure_password_123@localhost:5432/stock_analyst
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_analyst
DB_USER=stock_analyst_user
DB_PASSWORD=postgres_pass_123

# Cache Backend (PostgreSQL)
CACHE_BACKEND=postgresql
CACHE_DEFAULT_TTL=300

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24h
AUTH_ACCESS_EXPIRES_IN=15m

# AI Service
AI_SERVICE_URL=http://localhost:8000

# External APIs
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
NEWSAPI_KEY=your-newsapi-key-here
YFINANCE_API_KEY=optional

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-key-here
SMTP_FROM_EMAIL=noreply@stockanalyst.com

# Logging
LOG_LEVEL=debug
SENTRY_DSN=your-sentry-dsn-here

# CORS: comma-separated exact origins; production requires HTTPS and rejects wildcard.
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Settings
CACHE_TABLE_NAME=system_cache
CACHE_CLEANUP_INTERVAL_HOURS=1
