# Vercel Backend Project
NODE_ENV=production
PORT=3000

# PostgreSQL (managed DB)
DATABASE_URL=postgres://user:password@host:5432/stock_analyst_prod

# Auth / security
JWT_SECRET=replace_with_a_long_secure_secret_32_chars
AUTH_ACCESS_EXPIRES_IN=15m

# CORS: exact HTTPS origin only, no wildcard
CORS_ORIGIN=https://stock-analyst-frontend.vercel.app
ADMIN_API_KEY=

# Rate limiting / logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Optional feature flags
FORECAST_RESEARCH_PREVIEW=false
VNSTOCK_EOD_ENABLED=false
VNSTOCK_LISTING_SYNC_ENABLED=false
QUOTE_FRESHNESS_ENABLED=false
COMPANY_DATA_SYNC_ENABLED=false

# Keep these blank unless you intentionally use a real worker/service
VNSTOCK_WORKER_URL=
VITE_API_BASE_URL=
