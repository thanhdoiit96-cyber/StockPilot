# Backend Environment Configuration
# Copy this file to .env and update values according to your setup

# ===== Application Settings =====
NODE_ENV=development
FORECAST_RESEARCH_PREVIEW=true
# Optional absolute path; default: backend/evidence/forecast-research-preview.json
# FORECAST_PREVIEW_ARTIFACT=
PORT=5000
APP_NAME=Vietnamese Stock Analysis API
APP_VERSION=1.0.0

# ===== Database Connection =====
# PostgreSQL Configuration
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_analysis_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_LOGGING=false          # Set to true for SQL query logging
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== Cache Configuration =====
# Using PostgreSQL for caching (no Redis needed)
CACHE_BACKEND=postgresql
CACHE_DEFAULT_TTL=300     # Default TTL in minutes (5 minutes)
CACHE_CLEANUP_INTERVAL_HOURS=1  # Run cleanup job every hour
CACHE_TABLE_NAME=system_cache
CACHE_STATS_TABLE_NAME=cache_stats

# ===== Authentication =====
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=2h
AUTH_ACCESS_EXPIRES_IN=15m

# ===== API Security =====
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100   # Max requests per window
# Comma-separated exact origins. Production requires HTTPS and rejects wildcard.
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=

# ===== External Services =====
# AI/LLM Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Alternative: Using Claude
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229

# Stock Data APIs
STOCK_API_KEY=your_stock_api_key_here
STOCK_API_URL=https://api.example.com
STOCK_UPDATE_INTERVAL_MINUTES=5

# ===== Logging =====
LOG_LEVEL=info             # debug, info, warn, error
LOG_FORMAT=json            # json or text
LOG_DIR=./logs
LOG_MAX_SIZE=10m           # Max log file size
LOG_MAX_FILES=14           # Keep logs for 14 days

# ===== File Upload =====
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif
ALLOWED_DOCUMENT_TYPES=pdf,xls,xlsx,csv

# ===== Email Configuration =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=noreply@stockanalysis.com
SMTP_FROM_NAME=Stock Analysis Team

# ===== Redis (Optional - only if using Redis for sessions) =====
# Uncomment if planning to add Redis for sessions
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===== Monitoring & Analytics =====
SENTRY_DSN=your_sentry_dsn_for_error_tracking
ENABLE_PERFORMANCE_MONITORING=false
METRICS_INTERVAL_SECONDS=60

# ===== Development Tools =====
DEBUG=stock-analysis:*
NODEMON_WATCH=src
NODEMON_IGNORE=node_modules,logs,uploads

# ===== AWS Configuration (Optional - for production deployment) =====
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name

# ===== Database Backup =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===== Feature Flags =====
FEATURE_TECHNICAL_ANALYSIS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_PRICE_PREDICTION=true
FEATURE_RECOMMENDATION_ENGINE=true
FEATURE_LIVE_CHAT=false
FEATURE_SOCIAL_TRADING=false

# ===== Cache Preload =====
# Set to true to preload commonly accessed data on startup
CACHE_PRELOAD_ENABLED=true
CACHE_PRELOAD_TOP_STOCKS=20
CACHE_PRELOAD_INDUSTRIES=true

# VCI listing metadata only; weekday 15:15 Vietnam time, no price-history ingestion
VNSTOCK_LISTING_SYNC_ENABLED=true
VNSTOCK_LISTING_SYNC_CRON=15 15 * * 1-5
VNSTOCK_LISTING_SYNC_TIMEZONE=Asia/Ho_Chi_Minh

# EOD prices: first pass 30 minutes after close, then missing-symbol retries
VNSTOCK_EOD_ENABLED=true
VNSTOCK_EOD_CRON=30 15 * * 1-5
VNSTOCK_EOD_GAP_RETRY_CRON=*/15 16-19 * * 1-5
VNSTOCK_EOD_TIMEZONE=Asia/Ho_Chi_Minh
# Read-only price-board signal for ordering EOD gaps; EOD remains the only persisted source
VNSTOCK_EOD_TRADE_PRIORITY=true
VNSTOCK_EOD_TRADE_PRIORITY_TIMEOUT_MS=10000

# Sponsor-only foreign-flow history; disabled until API entitlement and display rights are confirmed
VNSTOCK_FOREIGN_FLOW_ENABLED=false
VNSTOCK_FOREIGN_FLOW_SYMBOLS=FPT,HPG,VHM
VNSTOCK_FOREIGN_FLOW_FROM=2026-10-01
VNSTOCK_FOREIGN_FLOW_TO=2026-10-13
# One-off diagnosis only; normal scheduled ingestion should use the serialized worker.
VNSTOCK_FOREIGN_FLOW_DIRECT=false
VNSTOCK_FOREIGN_FLOW_CRON=0 17 * * 1-5
VNSTOCK_FOREIGN_FLOW_TIMEZONE=Asia/Ho_Chi_Minh

# Sample VCI quote freshness during weekday market sessions (5 liquid symbols)
QUOTE_FRESHNESS_ENABLED=true
QUOTE_FRESHNESS_CRON=35 9,13 * * 1-5
QUOTE_FRESHNESS_TIMEZONE=Asia/Ho_Chi_Minh
# Non-realtime company snapshots; development-only and explicit opt-in.
# Start with the verified profile capability and a bounded liquid-symbol set.
COMPANY_DATA_SYNC_ENABLED=false
COMPANY_DATA_SYMBOLS=FPT,HPG,SSI,VCB,VNM
COMPANY_DATA_SCOPES=profile
COMPANY_DATA_CRON=30 18 * * 1-5
COMPANY_DATA_TIMEZONE=Asia/Ho_Chi_Minh
COMPANY_DATA_REQUEST_DELAY_MS=750
COMPANY_DATA_FAILURE_COOLDOWN_MS=10000
COMPANY_DATA_MAX_CONSECUTIVE_FAILURES=2
# Optional overrides: QUOTE_PROBE_SYMBOLS=FPT,SSI,VCB,HPG,BSR and QUOTE_API_URL=http://127.0.0.1:5000
