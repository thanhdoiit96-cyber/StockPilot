# Backend environment template
# Copy this file to backend/.env for local work. Do not commit the populated file.
# For Vercel, set the same values in Project Settings > Environment Variables.
# See docs/VERCEL_DEPLOYMENT.md before deploying.

# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database: use DATABASE_URL for a managed database, or use all DB_* values locally.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_analysis_db
DB_USER=postgres
DB_PASSWORD=<set-a-local-password>

# Browser authentication and API protection.
# Production requires a random JWT_SECRET with at least 32 characters and an exact HTTPS origin.
JWT_SECRET=development-only-change-me
AUTH_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional Python Vnstock worker. Keep readiness independent of it unless the deployment owns a worker.
VNSTOCK_WORKER_URL=http://127.0.0.1:8787
READINESS_REQUIRE_WORKER=false
READINESS_TIMEOUT_MS=1500

# Research previews remain off until their data/evidence gate is intentionally enabled.
FORECAST_RESEARCH_PREVIEW=false
FORECAST_LIVE_PREVIEW=false
# FORECAST_PREVIEW_ARTIFACT=

# Scheduled ingestion is disabled in a copied template. Enable one job only after its worker,
# provider rights, operating window, and evidence path have been verified.
VNSTOCK_EOD_ENABLED=false
# First EOD attempt starts five minutes after UPCoM closes; incomplete coverage retries later.
VNSTOCK_EOD_CRON=5 15 * * 1-5
VNSTOCK_EOD_GAP_RETRY_CRON=15,30,45 15 * * 1-5
VNSTOCK_EOD_LATE_GAP_RETRY_CRON=*/15 16-19 * * 1-5
VNSTOCK_LISTING_SYNC_ENABLED=false
QUOTE_FRESHNESS_ENABLED=false
RECOMMENDATION_EVALUATION_ENABLED=false
RECOMMENDATION_LIFECYCLE_CHECK_ENABLED=false
# Create a sealed recommendation snapshot only after a complete EOD ingest.
RECOMMENDATIONS_AFTER_INGEST=false
FORECAST_LIVE_CYCLE_ENABLED=false
VNSTOCK_FOREIGN_FLOW_ENABLED=false
COMPANY_DATA_SYNC_ENABLED=false

# Exit-guidance remains unscheduled and cannot create orders. This identity is used only by
# explicit bounded dry-runs and lease preflight; do not enable a worker without deployment authority.
# EXIT_GUIDANCE_EOD_OWNER_ID=
# EXIT_GUIDANCE_EOD_LEASE_KEY=position-exit-eod:vnstock:position_exit_rule_v1
# EXIT_GUIDANCE_EOD_LEASE_MS=60000
# EXIT_GUIDANCE_EOD_WORKER_ENABLED=false

# Optional provider configuration. Add a value only when the relevant adapter and rights are enabled.
# VNSTOCK_API_KEY=
# EODHD_API_KEY=
# EODHD_SYMBOL_SUFFIX=.VN
# EXTERNAL_FACTOR_DISPLAY_RIGHTS=
