{
  "name": "stock-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "npm run check:encoding && node --test src/services/*.test.mjs src/runtime/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "node scripts/safe-build.mjs",
    "build:raw": "vite build",
    "start": "vite preview",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:source-parity": "node scripts/check-source-parity.mjs",
    "normalize:recovered-source": "node scripts/normalize-recovered-source.mjs",
    "check:bundle": "node scripts/check-bundle-integrity.mjs",
    "check:prometheus": "node ../scripts/verify-prometheus-contract.mjs",
    "verify:live-analysis": "node scripts/verify-live-analysis.mjs",
    "measure:live:market-board": "node scripts/measure-live-market-board.mjs",
    "trace:live:market-board": "node scripts/trace-live-market-board-browser.mjs",
    "verify:release": "npm run test -- --runInBand && npm run check:bundle && npm run check:prometheus"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.0.0"
  }
}
