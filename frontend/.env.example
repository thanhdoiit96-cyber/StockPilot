# Frontend environment template
#
# Keep VITE_API_BASE_URL empty for local development and the recommended
# same-domain Vercel deployment. The browser then calls /api through the proxy.
# Never put database credentials, JWT secrets, or provider keys in VITE_*:
# every VITE_* value is embedded in the public browser bundle.
VITE_API_BASE_URL=

# Keep forecast panels disabled until their backend evidence gates pass.
VITE_ENABLE_FORECAST_RESEARCH=false
VITE_ENABLE_FORECAST_LIVE=false
